{
  "defaults": {
    "version": "1",
    "recipe": "collection.router",
    "components": [
      "MathLLM", "CodingLLM", "DefaultLLM",
      "classifier_1", "classifier_2", "classifier_3", "classifier_4",
      "classifier_match_true_1", "classifier_match_true_2",
      "topic", "default_label", "labelless"
    ],
    "routing": {
      "candidates": ["MathLLM", "CodingLLM", "DefaultLLM"],
      "default_model": "DefaultLLM",
      "classifiers": [
        { "id": "classifier_1", "type": "classifier", "model": "classifier_1", "labels": ["code"] },
        { "id": "classifier_2", "type": "classifier", "model": "classifier_2", "labels": ["code"] },
        { "id": "classifier_3", "type": "classifier", "model": "classifier_3", "labels": ["code"] },
        { "id": "classifier_4", "type": "classifier", "model": "classifier_4", "labels": ["code"] },
        { "id": "classifier_match_true_1", "type": "classifier", "model": "classifier_match_true_1", "labels": ["code"], "on_error": "match_true" },
        { "id": "classifier_match_true_2", "type": "classifier", "model": "classifier_match_true_2", "labels": ["code"], "on_error": "match_true" },
        { "id": "topic", "type": "classifier", "model": "topic", "labels": ["code", "math", "algebra"] },
        { "id": "default_label", "type": "classifier", "model": "default_label", "labels": ["code", "math"], "default_label": "code" },
        { "id": "labelless", "type": "classifier", "model": "labelless" }
      ]
    }
  },
  "policies": {
    "all_combinator": {
      "model_name": "user.Classifier-AllCombinator",
      "routing": {
        "rules": [
          { "id": "all-X-Y", "match": { "all": [
            { "classifier": "classifier_1", "label": "code", "min_score": 0.5 },
            { "classifier": "classifier_2", "label": "code", "min_score": 0.5 }
          ] }, "route_to": "CodingLLM" },
          { "id": "all-Z-W", "match": { "all": [
            { "classifier": "classifier_match_true_1", "label": "code", "min_score": 0.5 },
            { "classifier": "classifier_3", "label": "code", "min_score": 0.5 }
          ] }, "route_to": "MathLLM" }
        ]
      }
    },
    "band": {
      "model_name": "user.Classifier-Band",
      "routing": {
        "rules": [
          { "id": "code-band", "match": { "classifier": "topic", "label": "code", "min_score": 0.4, "max_score": 0.7 }, "route_to": "CodingLLM" },
          { "id": "math-default-band", "match": { "classifier": "topic", "label": "math" }, "route_to": "MathLLM" },
          { "id": "algebra-point", "match": { "classifier": "topic", "label": "algebra", "min_score": 0.8, "max_score": 0.8 }, "route_to": "MathLLM" }
        ]
      }
    },
    "combinator_match_true": {
      "model_name": "user.Classifier-Combinator-MatchTrue",
      "routing": {
        "rules": [
          { "id": "any-mt", "match": { "any": [
            { "classifier": "classifier_match_true_1", "label": "code", "min_score": 0.5 },
            { "classifier": "classifier_1", "label": "code", "min_score": 0.5 }
          ] }, "route_to": "CodingLLM" },
          { "id": "not-mt", "match": { "not": { "classifier": "classifier_match_true_2", "label": "code", "min_score": 0.5 } }, "route_to": "MathLLM" }
        ]
      }
    },
    "implicit_label": {
      "model_name": "user.Classifier-ImplicitLabel",
      "routing": {
        "rules": [
          { "id": "categorical-rule", "match": { "classifier": "default_label", "min_score": 0.5 }, "route_to": "CodingLLM" },
          { "id": "labelless-rule", "match": { "classifier": "labelless", "min_score": 0.5 }, "route_to": "MathLLM" }
        ]
      }
    },
    "label_selection": {
      "model_name": "user.Classifier-LabelSelection",
      "routing": {
        "rules": [
          { "id": "code-rule", "match": { "classifier": "topic", "label": "code", "min_score": 0.5 }, "route_to": "CodingLLM" },
          { "id": "math-rule", "match": { "classifier": "topic", "label": "math", "min_score": 0.5 }, "route_to": "MathLLM" }
        ]
      }
    },
    "nested_combinator": {
      "model_name": "user.Classifier-NestedCombinator",
      "routing": {
        "rules": [
          { "id": "not-any-P-Q", "match": { "not": { "any": [
            { "classifier": "classifier_1", "label": "code", "min_score": 0.5 },
            { "classifier": "classifier_2", "label": "code", "min_score": 0.5 }
          ] } }, "route_to": "CodingLLM" },
          { "id": "any-not-R-S", "match": { "any": [
            { "not": { "classifier": "classifier_3", "label": "code", "min_score": 0.5 } },
            { "classifier": "classifier_4", "label": "code", "min_score": 0.5 }
          ] }, "route_to": "MathLLM" }
        ]
      }
    },
    "on_error": {
      "model_name": "user.Classifier-OnError",
      "routing": {
        "rules": [
          { "id": "open-rule", "match": { "classifier": "classifier_1", "label": "code", "min_score": 0.5 }, "route_to": "CodingLLM" },
          { "id": "closed-rule", "match": { "classifier": "classifier_match_true_1", "label": "code", "min_score": 0.5 }, "route_to": "MathLLM" }
        ]
      }
    },
    "on_error_in_combinator": {
      "model_name": "user.Classifier-OnError-Combinator",
      "routing": {
        "rules": [
          { "id": "not-A", "match": { "not": { "classifier": "classifier_1", "label": "code", "min_score": 0.5 } }, "route_to": "CodingLLM" },
          { "id": "any-B-C", "match": { "any": [
            { "classifier": "classifier_2", "label": "code", "min_score": 0.5 },
            { "classifier": "classifier_3", "label": "code", "min_score": 0.5 }
          ] }, "route_to": "MathLLM" }
        ]
      }
    }
  }
}
