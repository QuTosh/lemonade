{
  "defaults": {
    "version": "1",
    "recipe": "collection.router",
    "components": [
      "TinyLLM",
      "BigLLM",
      "DefaultLLM",
      "RouterLLM"
    ],
    "routing": {
      "candidates": [
        "TinyLLM",
        "BigLLM",
        "DefaultLLM"
      ],
      "default_model": "DefaultLLM"
    }
  },
  "policies": {
    "core_form": {
      "model_name": "user.Router-L0a-Core-Form",
      "routing": {
        "classifiers": [
          {
            "id": "router",
            "type": "llm",
            "model": "RouterLLM",
            "prompt": "Route everyday questions to TinyLLM; hard reasoning to BigLLM.",
            "labels": [
              "TinyLLM",
              "BigLLM",
              "DefaultLLM"
            ]
          }
        ],
        "rules": [
          {
            "id": "route-TinyLLM",
            "match": {
              "classifier": "router",
              "label": "TinyLLM",
              "min_score": 1.0
            },
            "route_to": "TinyLLM"
          },
          {
            "id": "route-BigLLM",
            "match": {
              "classifier": "router",
              "label": "BigLLM",
              "min_score": 1.0
            },
            "route_to": "BigLLM"
          },
          {
            "id": "route-DefaultLLM",
            "match": {
              "classifier": "router",
              "label": "DefaultLLM",
              "min_score": 1.0
            },
            "route_to": "DefaultLLM"
          }
        ]
      }
    },
    "implicit_label": {
      "model_name": "user.Router-L0a-ImplicitLabel",
      "routing": {
        "classifiers": [
          {
            "id": "router",
            "type": "llm",
            "model": "RouterLLM",
            "prompt": "Route everyday questions to TinyLLM; hard reasoning to BigLLM.",
            "labels": [
              "TinyLLM",
              "BigLLM",
              "DefaultLLM"
            ],
            "default_label": "TinyLLM"
          }
        ],
        "rules": [
          {
            "id": "implicit-label-rule",
            "match": {
              "classifier": "router",
              "min_score": 1.0
            },
            "route_to": "TinyLLM"
          }
        ]
      }
    },
    "on_error": {
      "model_name": "user.Llm-OnError",
      "routing": {
        "classifiers": [
          {
            "id": "router",
            "type": "llm",
            "model": "RouterLLM",
            "prompt": "Route it.",
            "labels": [
              "TinyLLM",
              "BigLLM"
            ],
            "on_error": "match_true"
          }
        ],
        "rules": [
          {
            "id": "route-BigLLM",
            "match": {
              "classifier": "router",
              "label": "BigLLM",
              "min_score": 1.0
            },
            "route_to": "BigLLM"
          }
        ]
      }
    },
    "router_sugar": {
      "model_name": "user.Router-L0a-Sugar",
      "routing": {
        "router": {
          "type": "llm",
          "model": "RouterLLM",
          "prompt": "Route it."
        }
      }
    }
  }
}
